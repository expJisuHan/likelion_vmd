# backend/.env 로 복사해서 사용하세요.

# --- NVIDIA NIM ---
# https://build.nvidia.com 에서 발급받은 API 키
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.2-11b-vision-instruct
# 콤마로 구분된 대체 모델 목록 (요청 실패 시 순서대로 재시도)
NIM_FALLBACK_MODELS=meta/llama-3.2-90b-vision-instruct
NIM_TIMEOUT_SECONDS=180
# 요청에 직접 담아 보내는 base64 이미지 용량/해상도 제한 (초과 시 자동 리사이즈)
NIM_IMAGE_MAX_BYTES=180000
NIM_IMAGE_MAX_DIMENSION=1280

# --- App server ---
HOST=127.0.0.1
PORT=8000
# 코드 변경 시 자동 재시작 (개발용)
RELOAD=true

# --- CORS ---
# 프론트를 백엔드와 다른 origin/포트에서 띄울 때만 조정하세요.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Paths (backend/.. 기준 상대경로) ---
FRONTEND_DIR=frontend
OUTPUT_DIR=outputs
