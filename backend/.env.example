# backend/.env 로 복사해서 사용하세요.

# --- LM Studio ---
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=google/gemma-4-12b
# 콤마로 구분된 대체 모델 목록 (모델 로드 실패 시 순서대로 재시도)
LMSTUDIO_FALLBACK_MODELS=google/gemma-4-12b-qat,google/gemma-3-4b
LMSTUDIO_TIMEOUT_SECONDS=180

# --- App server ---
HOST=127.0.0.1
PORT=8000
# 코드 변경 시 자동 재시작 (개발용)
RELOAD=true

# --- CORS ---
# 프론트를 백엔드와 다른 origin/포트에서 띄울 때만 조정하세요.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Paths (backend/.. 기준 상대경로) ---
FRONTEND_DIR=frontend
OUTPUT_DIR=outputs
