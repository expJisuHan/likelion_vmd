# backend/.env 로 복사해서 사용하세요.

# --- NVIDIA NIM ---
# https://build.nvidia.com 에서 발급받은 API 키
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.2-11b-vision-instruct
# 콤마로 구분된 대체 모델 목록 (요청 실패 시 순서대로 재시도)
NIM_FALLBACK_MODELS=meta/llama-3.2-90b-vision-instruct
NIM_TIMEOUT_SECONDS=180
# 요청에 직접 담아 보내는 base64 이미지 용량/해상도 제한 (초과 시 자동 리사이즈)
NIM_IMAGE_MAX_BYTES=180000
NIM_IMAGE_MAX_DIMENSION=1280

# --- App server ---
HOST=127.0.0.1
PORT=8000
# 코드 변경 시 자동 재시작 (개발용)
RELOAD=true

# --- CORS ---
# 프론트를 백엔드와 다른 origin/포트에서 띄울 때만 조정하세요.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- 분석 엔드포인트(/api/analyze, /api/batch-analyze) 오남용 방어 ---
# 값을 채우면 요청 헤더 X-App-Key가 이 값과 일치해야만 호출을 허용합니다. 비우면 검사하지 않습니다.
APP_ACCESS_KEY=
# IP당 RATE_LIMIT_WINDOW_SECONDS 동안 허용하는 요청 수. 0 이하면 레이트리밋을 끕니다.
RATE_LIMIT_REQUESTS=12
RATE_LIMIT_WINDOW_SECONDS=60
# 요청 1건에 포함 가능한 최대 이미지 장수 / 이미지 1장당 최대 용량(byte)
MAX_IMAGES_PER_REQUEST=20
MAX_IMAGE_BYTES=8000000

# --- Paths (backend/.. 기준 상대경로) ---
FRONTEND_DIR=frontend
OUTPUT_DIR=outputs
