# Python cache and local environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environment files
.env
.env.*
!.env.example

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp

# Node/Vite frontend
node_modules/
app/static/dist/
.vite/
.vercel

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Claude Code / Codex local workspace metadata
.claude/
.agents/
.codex/
*.tgz
skills-lock.json

# Generated VMD analysis outputs
outputs/**
!outputs/
!outputs/excel/
!outputs/json/
!outputs/excel/.gitkeep
!outputs/json/.gitkeep

# Local sample/upload data
data/samples/**
!data/samples/
!data/samples/.gitkeep
